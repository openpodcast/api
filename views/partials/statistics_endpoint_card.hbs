<article class="endpoint-card">
    <div class="endpoint-header">
        <h2>{{provider}}/{{endpoint}}</h2>
        <span class="freshness-pill" title="{{lastSuccessfulAt}}">{{lastSuccessfulLabel}}</span>
    </div>

    <div class="daily-bars" aria-label="Daily successful endpoint imports">
        {{#each days}}
            {{#if hasUpdates}}
                <div class="daily-bar has-updates" title="{{title}}"></div>
            {{else}}
                <div class="daily-bar" title="{{title}}"></div>
            {{/if}}
        {{/each}}
    </div>

    <div class="stats-row">
        <span>{{successfulUpdates}} successful imports</span>
        <span>{{activeDays}} days with imports</span>
    </div>

    <div class="note">
        {{podcastCount}} podcasts have recorded at least one successful import for this endpoint.
    </div>
</article>
