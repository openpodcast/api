<div class='failed-podcasts'>
    <div class='failed-title'>Failed podcasts</div>
    {{#if failedPodcasts}}
        <ul class='podcast-list'>
            {{#each failedPodcasts}}
                <li>
                    {{#if podcastName}}
                        {{podcastName}}
                        (#{{podcastId}})
                    {{else}}
                        #{{podcastId}}
                    {{/if}}
                </li>
            {{/each}}
        </ul>
    {{else}}
        <div class='empty-state'>None</div>
    {{/if}}
</div>