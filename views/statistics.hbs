<!DOCTYPE html>
<html>
<head>
    <title>Open Podcast Import Issues</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f7fb;
            color: #1f2937;
            font-family: Arial, Helvetica, sans-serif;
        }

        .page {
            width: min(100%, 1120px);
            margin: 0 auto;
            padding: 48px 24px;
        }

        .hero {
            border-radius: 8px;
            color: #fff;
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 14px;
            padding: 18px 24px;
        }

        .hero.ok {
            background: #2da44e;
        }

        .hero.issues {
            background: #bf8700;
        }

        .hero-icon {
            margin-right: 8px;
        }

        .intro {
            color: #4b5563;
            line-height: 1.5;
            margin: 0 0 36px;
            max-width: 820px;
        }

        .heading-row {
            align-items: flex-end;
            display: flex;
            gap: 18px;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        h1 {
            font-size: 1.9rem;
            line-height: 1.2;
            margin: 0;
        }

        .meta {
            color: #6b7280;
            font-size: 0.92rem;
            line-height: 1.5;
            text-align: right;
        }

        .summary-grid {
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            margin-bottom: 24px;
        }

        .summary-card {
            background: #fff;
            border: 1px solid #d8dee4;
            border-radius: 8px;
            padding: 16px;
        }

        .summary-label {
            color: #6b7280;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .summary-value {
            font-size: 1.6rem;
            font-weight: 700;
        }

        .section-title {
            font-size: 1.18rem;
            margin: 28px 0 12px;
        }

        .group-grid {
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-bottom: 24px;
        }

        .group-card {
            background: #fff;
            border: 1px solid #d8dee4;
            border-radius: 8px;
            padding: 16px;
        }

        .group-header {
            align-items: flex-start;
            display: flex;
            gap: 12px;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .group-title {
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.35;
            word-break: break-word;
        }

        .group-meta {
            color: #4b5563;
            font-size: 0.92rem;
            line-height: 1.45;
            margin-bottom: 10px;
        }

        .mini-list {
            color: #6b7280;
            font-size: 0.9rem;
            line-height: 1.45;
            margin: 0;
            padding-left: 18px;
        }

        .mini-list li + li {
            margin-top: 4px;
        }

        .grafana-link {
            color: #0969da;
            display: inline-flex;
            font-size: 0.9rem;
            font-weight: 700;
            margin-top: 10px;
            text-decoration: none;
        }

        .grafana-link:hover {
            text-decoration: underline;
        }

        .panel {
            background: #fff;
            border: 1px solid #d8dee4;
            border-radius: 8px;
            overflow: hidden;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th,
        td {
            border-bottom: 1px solid #e5e7eb;
            padding: 12px 14px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: #f9fafb;
            color: #374151;
            font-size: 0.78rem;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .podcast-id,
        .age {
            font-weight: 700;
            white-space: nowrap;
        }

        .endpoint {
            word-break: break-word;
        }

        .timestamp,
        .guidance,
        .logs-link {
            color: #6b7280;
            font-size: 0.92rem;
            line-height: 1.4;
        }

        .logs-link a {
            color: #0969da;
            font-weight: 700;
            text-decoration: none;
        }

        .logs-link a:hover {
            text-decoration: underline;
        }

        .severity {
            border-radius: 999px;
            display: inline-flex;
            font-size: 0.82rem;
            font-weight: 700;
            padding: 5px 10px;
            white-space: nowrap;
        }

        .severity.stale {
            background: #fff8c5;
            border: 1px solid #eac54f;
            color: #7d4e00;
        }

        .severity.concerning {
            background: #ffebe9;
            border: 1px solid #ffaba8;
            color: #9a3412;
        }

        .severity.serious {
            background: #b42318;
            border: 1px solid #b42318;
            color: #fff;
        }

        .empty-state {
            color: #4b5563;
            line-height: 1.5;
            padding: 24px;
        }

        @media (max-width: 760px) {
            .page {
                padding: 28px 12px;
            }

            .heading-row {
                align-items: flex-start;
                flex-direction: column;
            }

            .meta {
                text-align: left;
            }

            .summary-grid,
            .group-grid {
                grid-template-columns: 1fr;
            }

            table,
            thead,
            tbody,
            th,
            td,
            tr {
                display: block;
            }

            thead {
                display: none;
            }

            tr {
                border-bottom: 1px solid #e5e7eb;
                padding: 12px 0;
            }

            tr:last-child {
                border-bottom: none;
            }

            td {
                border-bottom: none;
                padding: 6px 14px;
            }

            td::before {
                color: #6b7280;
                content: attr(data-label);
                display: block;
                font-size: 0.76rem;
                font-weight: 700;
                letter-spacing: 0.03em;
                margin-bottom: 2px;
                text-transform: uppercase;
            }
        }
    </style>
</head>

<body>
    <main class="page">
        {{#if summary.hasIssues}}
            <section class="hero issues" aria-live="polite">
                <span class="hero-icon">!</span>Import issues detected
            </section>
        {{else}}
            <section class="hero ok" aria-live="polite">
                <span class="hero-icon">✓</span>No stale imports detected
            </section>
        {{/if}}

        <p class="intro">
            This page renders the same latest-success data used by the JSON <code>/status</code> endpoint.
            It flags podcast endpoints whose latest successful update is more than {{staleAgeHours}} hours old.
            Failed pipeline attempts are not shown yet because they are not reported to the API.
        </p>

        <div class="heading-row">
            <h1>Open Podcast Import Issues</h1>
            <div class="meta">
                <div>Threshold: older than {{staleAgeHours}} hours</div>
                <div>Generated at {{generatedAt}}</div>
            </div>
        </div>

        <section class="summary-grid" aria-label="Import issue summary">
            <div class="summary-card">
                <div class="summary-label">Issues</div>
                <div class="summary-value">{{summary.issueCount}}</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">Podcasts</div>
                <div class="summary-value">{{summary.affectedPodcastCount}}</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">Endpoints</div>
                <div class="summary-value">{{summary.affectedEndpointCount}}</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">Worst delay</div>
                <div class="summary-value">
                    {{#if summary.worstAgeHours}}{{summary.worstAgeHours}}h{{else}}0h{{/if}}
                </div>
            </div>
        </section>

        {{#if issues}}
            <h2 class="section-title">Grouped by endpoint</h2>
            <section class="group-grid" aria-label="Issues grouped by endpoint">
                {{#each endpointGroups}}
                    <article class="group-card">
                        <div class="group-header">
                            <div class="group-title">{{provider}}/{{endpoint}}</div>
                            <span class="severity {{severity}}">{{severityLabel}}</span>
                        </div>
                        <div class="group-meta">
                            Affected podcasts: {{affectedPodcastCount}} · Stale imports: {{issueCount}} · Worst delay: {{worstAgeHours}}h
                        </div>
                        <ol class="mini-list">
                            {{#each issues}}
                                <li>#{{podcastId}} · {{ageHours}}h since {{latestUpdateAt}}</li>
                            {{/each}}
                        </ol>
                        <a class="grafana-link" href="{{grafanaUrl}}" target="_blank" rel="noopener noreferrer">Open Grafana logs</a>
                    </article>
                {{/each}}
            </section>

            <h2 class="section-title">Grouped by podcast</h2>
            <section class="group-grid" aria-label="Issues grouped by podcast">
                {{#each podcastGroups}}
                    <article class="group-card">
                        <div class="group-header">
                            <div class="group-title">Podcast #{{podcastId}}</div>
                            <span class="severity {{severity}}">{{severityLabel}}</span>
                        </div>
                        <div class="group-meta">
                            Affected endpoints: {{affectedEndpointCount}} · Stale imports: {{issueCount}} · Worst delay: {{worstAgeHours}}h
                        </div>
                        <ol class="mini-list">
                            {{#each issues}}
                                <li>{{provider}}/{{endpoint}} · {{ageHours}}h since {{latestUpdateAt}}</li>
                            {{/each}}
                        </ol>
                        <a class="grafana-link" href="{{grafanaUrl}}" target="_blank" rel="noopener noreferrer">Open Grafana logs</a>
                    </article>
                {{/each}}
            </section>
        {{/if}}

        <h2 class="section-title">Details</h2>
        <section class="panel" aria-label="Stale podcast endpoints">
            {{#if issues}}
                <table>
                    <thead>
                        <tr>
                            <th>Podcast</th>
                            <th>Endpoint</th>
                            <th>Age</th>
                            <th>Last success</th>
                            <th>Severity</th>
                            <th>Guidance</th>
                            <th>Logs</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each issues}}
                            <tr>
                                <td class="podcast-id" data-label="Podcast">#{{podcastId}}</td>
                                <td class="endpoint" data-label="Endpoint">{{provider}}/{{endpoint}}</td>
                                <td class="age" data-label="Age">{{ageHours}}h</td>
                                <td class="timestamp" data-label="Last success">{{latestUpdateAt}}</td>
                                <td data-label="Severity">
                                    <span class="severity {{severity}}">{{severityLabel}}</span>
                                </td>
                                <td class="guidance" data-label="Guidance">{{guidance}}</td>
                                <td class="logs-link" data-label="Logs">
                                    <a href="{{grafanaUrl}}" target="_blank" rel="noopener noreferrer">Grafana</a>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            {{else}}
                <div class="empty-state">
                    Every recorded podcast endpoint has a successful update within the last {{staleAgeHours}} hours.
                </div>
            {{/if}}
        </section>
    </main>
</body>
</html>
