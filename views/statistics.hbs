<!DOCTYPE html>
<html>
<head>
    <title>Open Podcast Status</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f7fb;
            color: #1f2937;
            font-family: Arial, Helvetica, sans-serif;
        }

        .page {
            width: min(100%, 1120px);
            margin: 0 auto;
            padding: 48px 24px;
        }

        .hero {
            border-radius: 8px;
            background: #2da44e;
            color: #fff;
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 36px;
            padding: 18px 24px;
        }

        .hero-icon {
            margin-right: 8px;
        }

        .heading-row {
            align-items: flex-end;
            display: flex;
            gap: 18px;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        h1 {
            font-size: 1.9rem;
            line-height: 1.2;
            margin: 0;
        }

        .meta {
            color: #6b7280;
            font-size: 0.92rem;
            line-height: 1.5;
            text-align: right;
        }

        .grid {
            background: #fff;
            border: 1px solid #d8dee4;
            border-radius: 8px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            overflow: hidden;
        }

        .endpoint-card {
            border-bottom: 1px solid #d8dee4;
            min-height: 210px;
            padding: 24px;
        }

        .endpoint-card:nth-child(odd) {
            border-right: 1px solid #d8dee4;
        }

        .endpoint-header {
            align-items: center;
            display: flex;
            gap: 12px;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        h2 {
            font-size: 1.08rem;
            line-height: 1.3;
            margin: 0;
            word-break: break-word;
        }

        .status-dot {
            align-items: center;
            border-radius: 999px;
            color: #fff;
            display: inline-flex;
            flex: 0 0 auto;
            font-size: 0.85rem;
            font-weight: 700;
            height: 28px;
            justify-content: center;
            width: 28px;
        }

        .status-dot.operational {
            background: #2da44e;
        }

        .status-dot.degraded {
            background: #bf8700;
        }

        .daily-bars {
            display: flex;
            gap: 2px;
            margin-bottom: 12px;
        }

        .daily-bar {
            background: #8ddb9a;
            border-radius: 3px;
            flex: 1 1 0;
            height: 42px;
            min-width: 2px;
        }

        .daily-bar.degraded {
            background: #d4a72c;
        }

        .daily-bar.unavailable {
            background: #d1d5db;
        }

        .stats-row {
            align-items: center;
            color: #6b7280;
            display: flex;
            font-size: 0.95rem;
            gap: 12px;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .failed-podcasts {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            padding: 12px;
        }

        .failed-title {
            color: #374151;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .podcast-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 0;
            padding: 0;
        }

        .podcast-list li {
            background: #fff;
            border: 1px solid #d1d5db;
            border-radius: 999px;
            color: #374151;
            display: inline-flex;
            font-size: 0.88rem;
            list-style: none;
            padding: 5px 10px;
        }

        .empty-state {
            color: #6b7280;
            font-size: 0.95rem;
        }

        @media (max-width: 760px) {
            .page {
                padding: 28px 12px;
            }

            .heading-row {
                align-items: flex-start;
                flex-direction: column;
            }

            .meta {
                text-align: left;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .endpoint-card {
                padding: 18px;
            }

            .endpoint-card:nth-child(odd) {
                border-right: none;
            }

            .daily-bars {
                gap: 1px;
            }

            .daily-bar {
                height: 34px;
            }
        }
    </style>
</head>

<body>
    <main class="page">
        <section class="hero" aria-live="polite">
            <span class="hero-icon">✓</span>Import status
        </section>

        <div class="heading-row">
            <h1>Current Status: Open Podcast Imports</h1>
            <div class="meta">
                <div>Endpoint imports over the past {{periodDays}} days.</div>
                <div>Generated at {{generatedAt}}</div>
            </div>
        </div>

        <section class="grid" aria-label="Endpoint status">
            {{#each endpoints}}
                {{> statistics-endpoint-card}}
            {{/each}}
        </section>
    </main>
</body>
</html>
